# Preferred option for this project: OpenRouter key
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional OpenRouter metadata headers
# OPENROUTER_HTTP_REFERER=https://your-app.example.com
# OPENROUTER_APP_NAME=CMUGPT Next

# Alternative: AI Gateway key (if you use gateway model ids)
# AI_GATEWAY_API_KEY=

# Model id to use for chat requests
AI_CHAT_MODEL=anthropic/claude-sonnet-4.5

# Optional single MCP server URL fallback
# MCP_SERVER_URL=https://your-mcp-server.example.com/mcp

# Preferred MCP config format (JSON array)
# MCP_SERVERS_JSON=[{"id":"cmu_api","type":"http","url":"https://mcp-server-production-75c7.up.railway.app/mcp"}]
